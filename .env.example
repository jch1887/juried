# Environment variables read by juried.
#
# juried never reads this file itself: it only reads the process environment. Copy it
# to .env, fill in the values you need, then load it into your shell before running:
#
#   set -a; source .env; set +a
#
# or let direnv, your CI secrets store or your shell profile export them.

# ---------------------------------------------------------------------------
# Judge and generation providers. Only the key for the provider named in
# [judge] (or [generate]) of juried.toml is needed. The stub provider needs none.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Target credentials. The url, headers and body in [target] of juried.toml may
# reference any variable as ${NAME}; a missing variable stops the run with an error.
# Name these to match your own config, for example:
#   headers = { Authorization = "Bearer ${STAGING_TOKEN}" }
# ---------------------------------------------------------------------------
STAGING_TOKEN=

# ---------------------------------------------------------------------------
# Overrides for juried.toml. Any scalar key can be set as JURIED_<SECTION>_<KEY>
# and takes precedence over the file. Sections: target, criteria, run, judge,
# generate. Nested values such as target.headers and target.body cannot be
# overridden this way. Leave unset to use the values in juried.toml.
# ---------------------------------------------------------------------------

# [target]
#JURIED_TARGET_URL=https://staging.example.com/api/chat
#JURIED_TARGET_METHOD=POST
#JURIED_TARGET_RESPONSE_PATH=reply
#JURIED_TARGET_TIMEOUT_SECONDS=30
#JURIED_TARGET_RETRIES=3
# Pricing the target side of a run. Name the token counts in the reply and the prices in
# US dollars per million tokens, or a flat price per call for a target with no token
# counts. With neither, the run reports requests and says the cost is unknown.
#JURIED_TARGET_USAGE_INPUT_PATH=usage.prompt_tokens
#JURIED_TARGET_USAGE_OUTPUT_PATH=usage.completion_tokens
#JURIED_TARGET_INPUT_PRICE=
#JURIED_TARGET_OUTPUT_PRICE=
#JURIED_TARGET_COST_PER_REQUEST=

# [criteria]
#JURIED_CRITERIA_FILE=acceptance.md
#JURIED_CRITERIA_SCENARIOS_DIR=scenarios
#JURIED_CRITERIA_CALIBRATION_DIR=calibration

# [run]
#JURIED_RUN_RUNS=20
# Failed attempts a scenario may have and still pass: 20 runs with 1 miss need 19/20.
#JURIED_RUN_MISSES=1
# Deprecated since 0.3 and removed in 0.4: misses is derived from it when misses is unset.
#JURIED_RUN_THRESHOLD=
# Requests in flight to the target, across every scenario in the run.
#JURIED_RUN_CONCURRENCY=4
#JURIED_RUN_CACHE_DIR=.juried
# Replays saved responses instead of sampling the feature. Keep false in CI.
#JURIED_RUN_CACHE_RESPONSES=false
#JURIED_RUN_REPORT_DIR=reports

# [judge]  provider is anthropic, openai or stub
#JURIED_JUDGE_PROVIDER=anthropic
#JURIED_JUDGE_MODEL=claude-sonnet-5
#JURIED_JUDGE_TEMPERATURE=0.0
#JURIED_JUDGE_MAX_TOKENS=2048
#JURIED_JUDGE_BASE_URL=
# Odd number of verdicts per response; the majority decides.
#JURIED_JUDGE_VOTES=1
# US dollars per million tokens, set together, to override the built in price table.
#JURIED_JUDGE_INPUT_PRICE=
#JURIED_JUDGE_OUTPUT_PRICE=
# Judge requests in flight, across every scenario in the run.
#JURIED_JUDGE_CONCURRENCY=4

# [generate]  provider and model default to the [judge] values; temperature does not
#JURIED_GENERATE_PROVIDER=
#JURIED_GENERATE_MODEL=
#JURIED_GENERATE_TEMPERATURE=
#JURIED_GENERATE_BASE_URL=
#JURIED_GENERATE_SCENARIOS_PER_CRITERION=4
#JURIED_GENERATE_MAX_TOKENS=4096
